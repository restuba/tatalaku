{
  "name": "tatalaku",
  "version": "1.0.0",
  "private": true,
  "description": "Tatalaku — Notion-like workspace web application",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/mermaid": "^9.2.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tiptap/extension-bubble-menu": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-table-cell": "^3.30.3",
    "@tiptap/extension-table-header": "^3.30.3",
    "@tiptap/extension-table-row": "^3.30.3",
    "mermaid": "^11.17.2"
  }
}
